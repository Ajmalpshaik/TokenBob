<Window x:Class="TokenBob.App.Account.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Claude — TokenBob"
        Width="480" Height="680"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="14,10" TextWrapping="Wrap" Foreground="#5F5E5A"
                   Text="Sign in with your usual Claude account. TokenBob only reads your 5-hour and weekly usage. This window closes by itself when you're signed in." />
        <wv2:WebView2 x:Name="View" />
    </DockPanel>
</Window>
