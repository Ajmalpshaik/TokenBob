<Window x:Class="TokenBob.App.Widget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widget="clr-namespace:TokenBob.App.Widget"
        Title="TokenBob"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Canvas x:Name="Root">
        <widget:RopeVisual x:Name="Rope" IsHitTestVisible="False" />
        <!-- Holds the current ornament style; input and hover are wired to the host. -->
        <Border x:Name="Host" Cursor="Hand" />
        <Popup x:Name="Hover" PlacementTarget="{Binding ElementName=Host}" Placement="Left"
               AllowsTransparency="True" StaysOpen="True" Focusable="False" PopupAnimation="Fade">
            <widget:HoverCard x:Name="HoverContent" />
        </Popup>
    </Canvas>
</Window>
