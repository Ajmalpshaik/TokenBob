<Window x:Class="TokenBob.App.Widget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widget="clr-namespace:TokenBob.App.Widget"
        xmlns:styles="clr-namespace:TokenBob.App.Widget.Styles"
        Title="TokenBob"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Canvas x:Name="Root">
        <widget:RopeVisual x:Name="Rope" IsHitTestVisible="False" />
        <styles:RingOrnament x:Name="Ring" Cursor="Hand" />
    </Canvas>
</Window>
