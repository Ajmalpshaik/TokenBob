<UserControl x:Class="TokenBob.App.Widget.HoverCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Frame" CornerRadius="10" Padding="12,9,14,9" Margin="0,0,10,0"
            Background="White" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
        </Border.Effect>
        <DockPanel>
            <Rectangle x:Name="Accent" DockPanel.Dock="Left" Width="3" RadiusX="1.5" RadiusY="1.5"
                       Margin="0,2,10,2" Fill="#3FA45B" />
            <StackPanel x:Name="Lines" />
        </DockPanel>
    </Border>
</UserControl>
