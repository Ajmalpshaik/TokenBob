<Window x:Class="TokenBob.App.Install.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install TokenBob"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/TokenBob.ico"
        Background="#F7F6F2"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="24,22,24,20">
        <DockPanel>
            <Image Source="/Assets/TokenBob.ico" Width="48" Height="48" DockPanel.Dock="Left" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="Install TokenBob" FontSize="20" FontWeight="SemiBold" Foreground="#1F1E1C" />
                <TextBlock Text="A hanging Claude usage meter for your desktop" Foreground="#5F5E5A" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Background="White" BorderBrush="#E4E2DA" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#3A3A38">
                    Installs for you only — no admin password needed. You'll find it in the Start menu,
                    and you can remove it any time from Settings → Apps → Installed apps.
                </TextBlock>
                <CheckBox x:Name="StartWithWindows" Content="Start with Windows" IsChecked="True" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="Status" Foreground="#5F5E5A" Margin="0,12,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="Cancel" Content="Cancel" Padding="16,5" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="InstallButton" Content="Install" Padding="22,5" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
