<Window x:Class="TokenBob.App.Install.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install TokenBob"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/TokenBob.ico"
        Background="{DynamicResource Ui.Window}"
        Foreground="{DynamicResource Ui.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <StackPanel Margin="26,24,26,22">
        <DockPanel>
            <Image Source="/Assets/TokenBob.ico" Width="52" Height="52" DockPanel.Dock="Left" Margin="0,0,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="Install TokenBob" FontSize="21" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI" />
                <TextBlock Text="A hanging Claude usage meter for your desktop" Foreground="{DynamicResource Ui.Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Ui.Card}" Padding="16,12" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ui.Text}" LineHeight="20">
                    Installs for you only — no admin password needed. You'll find it in the Start menu,
                    and you can remove it any time from Settings → Apps → Installed apps.
                </TextBlock>
                <Border Style="{StaticResource Ui.Divider}" Margin="0,12" />
                <CheckBox x:Name="StartWithWindows" Style="{StaticResource Ui.Toggle}" IsChecked="True">
                    <StackPanel>
                        <TextBlock Text="Start with Windows" Style="{StaticResource Ui.RowLabel}" />
                        <TextBlock Text="So it's always hanging there when you sign in" Style="{StaticResource Ui.Hint}" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <TextBlock x:Name="Status" Foreground="{DynamicResource Ui.Muted}" Margin="0,12,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="Cancel" Content="Cancel" Style="{StaticResource Ui.Button}" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="InstallButton" Content="Install" Style="{StaticResource Ui.AccentButton}" Padding="24,6" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
