<Window x:Class="TokenBob.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenBob settings"
        Width="420" SizeToContent="Height" MaxHeight="760"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/TokenBob.ico"
        Background="#F7F6F2"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5F5E5A" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E2DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,4,18,18">
            <TextBlock Style="{StaticResource Section}" Text="Look" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ornament" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="StyleRing" Content="Ring" GroupName="style" />
                        <RadioButton x:Name="StyleTag" Content="Hanging tag" GroupName="style" />
                    </StackPanel>
                    <TextBlock Text="Rope" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RopeCord" Content="Twisted cord" GroupName="rope" />
                        <RadioButton x:Name="RopeChain" Content="Bead chain" GroupName="rope" />
                    </StackPanel>
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock x:Name="RopeLengthValue" DockPanel.Dock="Right" Foreground="#5F5E5A" />
                        <TextBlock Text="Rope length" />
                    </DockPanel>
                    <Slider x:Name="RopeLength" Minimum="60" Maximum="400" SmallChange="5" LargeChange="20" />
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock x:Name="OrnamentSizeValue" DockPanel.Dock="Right" Foreground="#5F5E5A" />
                        <TextBlock Text="Ornament size" />
                    </DockPanel>
                    <Slider x:Name="OrnamentSize" Minimum="80" Maximum="140" SmallChange="5" LargeChange="10" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Motion" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock DockPanel.Dock="Right" Text="Bouncy" Foreground="#5F5E5A" />
                        <TextBlock Text="Swing  ·  Calm" />
                    </DockPanel>
                    <Slider x:Name="Swing" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" />
                    <CheckBox x:Name="Wind" Content="Sway when the mouse rushes past" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Data" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <ComboBox x:Name="Refresh" DockPanel.Dock="Right" Width="110" />
                        <TextBlock Text="Refresh every" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="RefreshNow" DockPanel.Dock="Right" Content="Refresh now" Padding="12,3" />
                        <TextBlock x:Name="DataStatus" Foreground="#5F5E5A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Alerts" />
            <Border Style="{StaticResource Card}">
                <CheckBox x:Name="Notifications" Content="Windows notifications at 80% and 95%" />
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Behavior" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindows" Content="Start with Windows" />
                    <CheckBox x:Name="AutoHide" Content="Hide while a fullscreen app is running" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Account" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button x:Name="SignInOut" DockPanel.Dock="Right" Content="Sign in" Padding="12,3" />
                    <TextBlock x:Name="AccountStatus" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="About" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button x:Name="Quit" DockPanel.Dock="Right" Content="Quit TokenBob" Padding="12,3" />
                    <StackPanel>
                        <TextBlock x:Name="VersionText" />
                        <TextBlock Margin="0,2,0,0">
                            <Hyperlink x:Name="RepoLink">View on GitHub</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
